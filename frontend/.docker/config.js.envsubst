window.appConfig = {
  auth: {
    clientId: '$AUTH_CLIENT_ID',
    authority: 'https://login.microsoftonline.com/$AUTH_TENANT_ID',
  },
  redirectUri: '$REDIRECT_URI',
  apiEndpoint: '$API_BASEPATH',
  agGridLicenseKey: '$AGGRID_LICENSE',  // Only needed if using enterprise edition
  homeUri: '$HELP_HOME_URI' || 'https://github.com/microsoft/tim-data-investigate-platform',
  wikiUri: '$HELP_WIKI_URI' || 'https://github.com/microsoft/tim-data-investigate-platform/docs',
  issueUri: '$HELP_ISSUE_URI' || 'https://github.com/microsoft/tim-data-investigate-platform/issues/new?template=issue_template.md',
  featureUri: '$HELP_FEATURE_URI' || 'https://github.com/microsoft/tim-data-investigate-platform/issues/new?template=issue_template.md',
  tagCluster: '$KUSTO_CLUSTER_URI',
  tagDatabase: '$KUSTO_DATABASE_NAME' || 'tim-dev-adx-db',
  defaultClusters: [
    {
      name: 'Tag Cluster',
      clusters: ['$KUSTO_CLUSTER_URI'],
      databases: ['$KUSTO_DATABASE_NAME'],
    },
  ],
};
